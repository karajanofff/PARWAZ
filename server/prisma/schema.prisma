generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum StationStatus {
  ACTIVE
  WARNING
  OFFLINE
  MAINTENANCE
}

enum AlarmSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlarmStatus {
  ACTIVE
  RESOLVED
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(OPERATOR)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Station {
  id            String          @id @default(cuid())
  name          String
  region        String
  address       String
  latitude      Float
  longitude     Float
  mimoType      String
  portCount     Int
  beamCount     Int
  antennaGain   Float
  eirp          Float
  temperature   Float
  status        StationStatus   @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  kpiRecords    KpiRecord[]
  alarms        Alarm[]
  configuration Configuration?
}

model KpiRecord {
  id            String   @id @default(cuid())
  stationId     String
  rsrp          Float
  sinr          Float
  throughput    Float
  prbUsage      Float
  latency       Float
  packetLoss    Float
  coverageScore Float
  capacityScore Float
  recordedAt    DateTime @default(now())
  station       Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, recordedAt])
}

model Alarm {
  id          String        @id @default(cuid())
  stationId   String
  title       String
  description String
  severity    AlarmSeverity
  status      AlarmStatus   @default(ACTIVE)
  source      String
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  station     Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, status])
}

model Configuration {
  id               String   @id @default(cuid())
  stationId        String   @unique
  powerLimit       Float
  temperatureLimit Float
  alarmThreshold   Float
  schedulerMode    String
  beamMode         String
  updatedAt        DateTime @updatedAt
  station          Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
